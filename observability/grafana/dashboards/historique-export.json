  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Combien de lignes de l'export sont des doublons ?",
      "description": "Blocs strictement identiques (meme en-tete, meme JSON)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"history\", event=\"perf_spike\"} | json | dup=\"true\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"history\", event=\"game_completed\"} | json | dup=\"true\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "rapports"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "parties"
              }
            ]
          }
        ]
      }
