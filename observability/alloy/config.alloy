local.file_match "app" {
  path_targets = [{
    "__path__" = "/logs/*.log",
    "job"      = "game-telemetry",
    "service"  = "game-telemetry-demo",
  }]
}

loki.source.file "app" {
  targets    = local.file_match.app.targets
  forward_to = [loki.process.app.receiver]
}

loki.process "app" {
  stage.json {
    expressions = {
      ts    = "ts",
      level = "level",
      event = "event",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      level = "",
      event = "",
    }
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
